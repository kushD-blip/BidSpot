# Copy this file to .env (local dev with `vercel dev`) and fill in real values.
# In production, set these in Vercel → Project → Settings → Environment Variables instead
# of committing a .env file.

# --- Supabase (Settings > API in your Supabase project) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key      # server-only, bypasses RLS — never expose to the browser
SUPABASE_ANON_KEY=your-anon-public-key                # safe to expose client-side, used in js/supabase-client.js

# --- Razorpay (Dashboard > Settings > API Keys) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret          # server-only, never expose to the browser

# --- Cron protection ---
# Any random string. Vercel Cron calls your /api/cron/* routes with
# `Authorization: Bearer $CRON_SECRET` — set the same value here and in Vercel env vars
# so nobody else can trigger a manual reset/snapshot by guessing the URL.
CRON_SECRET=generate-a-long-random-string

# --- Transactional email (Resend) ---
# Payment receipts sent by api/verify-payment.js. Until BOTH are set, the receipt
# code is a no-op that logs — the payment path itself keeps working.
# RESEND_API_KEY comes from resend.com > Settings > API Keys (free tier: 100/day).
# RECEIPT_FROM_EMAIL must be a verified sender on your domain (Resend > Domains).
RESEND_API_KEY=
RECEIPT_FROM_EMAIL=

# --- Public URLs shown in receipts and other emails ---
PUBLIC_SITE_URL=https://bidspot.in
SUPPORT_EMAIL=

# --- Admin dashboard (/admin.html) ---
# Password prompt on the admin page hashes what the visitor types and compares
# to this value server-side. Any long random string works — treat like a shared
# secret between you and the server, not a user password.
ADMIN_PASSWORD=
